{
  "name": "@naturalcycles/semantic-release",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "upd": "pnpm up --no-save",
    "release": "node ./src/bin/release.js"
  },
  "dependencies": {
    "@semantic-release/git": "^10",
    "semantic-release": "^25"
  },
  "devDependencies": {
    "@types/node": "^24",
    "husky": "^9"
  },
  "bin": {
    "release": "src/bin/release.js"
  },
  "files": [
    "cfg",
    "src",
    "!src/test",
    "!src/**/*.test.*",
    "!src/**/__snapshots__",
    "!src/**/__exclude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaturalCycles/semantic-release.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.18.3",
  "description": "semantic-release with some tweaks and default config",
  "author": "Natural Cycles Team",
  "license": "MIT"
}
